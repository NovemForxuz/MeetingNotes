# Copy this file to .env and fill in your real values. .env is gitignored —
# never commit real keys/tokens.
OPENAI_API_KEY=your-key-here

# Only needed for discord_bot.py. Create a bot at
# https://discord.com/developers/applications and paste its token here.
DISCORD_BOT_TOKEN=your-bot-token-here

# Optional, discord_bot.py only. CRAIG_NAME_MAP: same format as pipeline.py's
# --name-map flag, set once instead of typed into Discord each time.
# CRAIG_NAME_MAP=discord_username1=Real Name1,discord_username2=Real Name2

# MEETING_NOTES_FILE: a fallback default for --notes-file. Prefer attaching
# your notes per-meeting via /meetingnotes' optional `notes` parameter instead
# (your notes are usually different each meeting) — only set this as a
# default to fall back on when you forget to attach one.
# MEETING_NOTES_FILE=C:\path\to\your_rough_notes.txt
